# Written to /etc/nginx/agrisage/api-proxy.conf at start-up when API_UPSTREAM is set (e.g. http://api:8080 or
# https://agrisage-api.example.org). The Host header stays the upstream's own, so a hosted API is routed correctly.
location /api/ {
    proxy_pass ${API_UPSTREAM};
    proxy_ssl_server_name on;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $agrisage_connection_upgrade;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $agrisage_forwarded_proto;
    proxy_set_header X-Forwarded-Host $host;
    proxy_read_timeout 300s;
    client_max_body_size 10m;
}
